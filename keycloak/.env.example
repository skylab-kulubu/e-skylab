KEYCLOAK_HOSTNAME=https://e.yildizskylab.com
KEYCLOAK_IMAGE_DIGEST=<64-character-published-manifest-digest-without-sha256-prefix>
KEYCLOAK_PROXY_TRUSTED_ADDRESSES=<reverse-proxy-container-ip-or-cidr>
KEYCLOAK_DB_HOST=sky-lab-production-postgres-ik33fe
KEYCLOAK_DB_PORT=5432
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USERNAME=<existing-keycloak-database-user>
KEYCLOAK_DB_PASSWORD=<set-in-secret-store>
KEYCLOAK_DB_SCHEMA=public
ACCOUNT_CENTER_BASE_URL=https://my.yildizskylab.com
KEYCLOAK_CONFIG_CLIENT_ID=account-center-config
KEYCLOAK_CONFIG_CLIENT_SECRET=<set-in-secret-store>

# One-time bootstrap only. Do not expose these to steady-state services.
KEYCLOAK_BOOTSTRAP_ADMIN_USERNAME=<temporary-bootstrap-admin>
KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=<temporary-bootstrap-password>

RABBITMQ_HOST=super-skylab-rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=<set-in-secret-store>
RABBITMQ_PASSWORD=<set-in-secret-store>
RABBITMQ_VHOST=/
RABBITMQ_EXCHANGE=keycloak.events
RABBITMQ_USE_TLS=false
